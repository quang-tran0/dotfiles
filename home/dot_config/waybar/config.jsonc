{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,
    "reload_style_on_change": true,
    "modules-left": [
        "clock"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/media",
        "pulseaudio",
        "network",
        "battery",
        "custom/weather"
    ],
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by": "number",
        "format-icons": {
            "urgent": "󰀨",
            "active": "",
            "default": ""
        }
    },
    "clock": {
        "format": "󰥔  {:%H:%M}",
        "format-alt": "󰃭  {:%a, %d %b %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/media": {
        "exec": "/home/quang-tran/.config/waybar/scripts/mediaplayer.py",
        "return-type": "json",
        "format": "{text}",
        "escape": true,
        "hide-empty-text": true,
        "max-length": 40,
        "restart-interval": 2,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "smooth-scrolling-threshold": 10
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "󰂯  {volume}%",
        "format-muted": "󰖁  muted",
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ],
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        }
    },
    "network": {
        "interval": 5,
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀  ethernet",
        "format-linked": "󰈀  no IP",
        "format-disconnected": "󰤭  offline",
        "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr} · {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "max-length": 28,
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "tooltip-format": "{time} · {power:.1f} W",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "custom/weather": {
        "exec": "/home/quang-tran/.config/waybar/scripts/get_weather.sh",
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "interval": 1800
    }
}
