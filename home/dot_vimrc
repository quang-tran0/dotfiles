" --- Tabs & Indentation ---
set tabstop=4                 " Render a horizontal tab (\t) as 4 spaces wide
set softtabstop=4             " Insert 4 spaces when pressing the Tab key
set shiftwidth=4              " Number of spaces used for each step of (auto)indent
set expandtab                 " Convert all inserted tab characters into spaces
set autoindent                " Copy indentation from the previous line on Enter
set smartindent               " Introduce context-dependent automatic indenting

" --- Search Mechanics ---
set hlsearch                  " Highlight all matching strings for the search pattern
set incsearch                 " Show search results incrementally as you type
set ignorecase                " Ignore uppercase/lowercase distinctions in search
set smartcase                 " Override 'ignorecase' if pattern contains capitals

" --- Backup & Performance ---
set nobackup                  " Prevent writing backup files before overwriting a file
set noswapfile                " Disable recovery swapfiles for snappier performance
set undofile                  " Persist undo history across application restarts
set undodir=~/.vim/undodir    " Centralized directory path for your undo files

augroup netrw_keys
  autocmd!
  " gu: nhảy con trỏ về dòng ../
  autocmd FileType netrw nnoremap <buffer> <silent> gu gg:call search('^\.\./')<CR>
augroup END


let mapleader = " "           " Map the primary prefix leader key to the Spacebar

nnoremap <leader>cd :Ex<CR>
nnoremap <leader>tn :tabnew<CR>
nnoremap <leader>1 1gt
nnoremap <leader>2 2gt
nnoremap <leader>3 3gt
nnoremap <leader>4 4gt
nnoremap <leader>5 5gt
nnoremap <leader>6 6gt
nnoremap <leader>7 7gt
nnoremap <leader>8 8gt
nnoremap <leader>9 9gt
nnoremap <leader>0 10gt
nnoremap <Tab> gt
