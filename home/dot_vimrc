let s:none    = ['NONE', 'NONE']

function! s:H(group, fg, bg, ...)
  let l:attr = a:0 ? a:1 : 'NONE'
  execute 'highlight ' . a:group
        \ . ' guifg=' . a:fg[0] . ' ctermfg=' . a:fg[1]
        \ . ' guibg=' . a:bg[0] . ' ctermbg=' . a:bg[1]
        \ . ' gui=' . l:attr . ' cterm=' . l:attr
endfunction

