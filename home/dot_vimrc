" --- Settings ---
set nocompatible              " Disable compatibility with old vi quirks
set encoding=utf-8            " Set internal character encoding to UTF-8
set number                    " Show absolute line numbers on the left sidebar
set relativenumber            " Show line numbers relative to the cursor (hybrid with 'number')
set history=1000              " Increase the Ex command execution history limit
set wildmenu                  " Enable visual autocomplete menu for command mode
set whichwrap+=<,>,h,l,[,]
set mouse=a

" --- UI & Appearance ---
syntax on                     " Enable contextual syntax highlighting
set wrap                      " Automatically wrap lines that exceed window width
set scrolloff=8               " Keep at least 8 vertical lines visible when scrolling
set laststatus=2              " Always show the status bar at the window bottom
set showcmd                   " Display incomplete macro/key commands in status bar
set cursorline                " Highlight the line the cursor is on

" --- Colors: Tokyo Night (xấp xỉ bằng 256 màu cho vim cũ) ---
set t_Co=256                  " Use 256-color palette (works inside tmux)
set t_ut=                     " Fix nền sai màu khi cuộn trong tmux
set background=dark
" set termguicolors           " Bật nếu vim >= 7.4.1778 và terminal hỗ trợ true color
highlight clear
if exists('syntax_on') | syntax reset | endif

